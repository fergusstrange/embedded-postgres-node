{
  "name": "embedded-postgres-node",
  "version": "0.1.0",
  "description": "Supervised, disposable PostgreSQL for Node.js tests using the embedded-postgres v2 CLI",
  "license": "MIT",
  "author": "Fergus Strange",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fergusstrange/embedded-postgres-node.git"
  },
  "homepage": "https://github.com/fergusstrange/embedded-postgres-node#readme",
  "bugs": {
    "url": "https://github.com/fergusstrange/embedded-postgres-node/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "docs/",
    "examples/"
  ],
  "keywords": [
    "postgres",
    "postgresql",
    "testing",
    "embedded",
    "vitest",
    "jest"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:coverage": "npm run build && c8 --all --include \"dist/esm/**/*.js\" --exclude \"dist/esm/index.js\" --reporter=text --reporter=json-summary --reporter=lcov --check-coverage --per-file --lines 90 --functions 90 --branches 90 --statements 90 node --test test/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration/*.test.mjs",
    "test:examples": "node scripts/test-examples.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:release": "node scripts/check-package.mjs --real",
    "prepack": "npm run build",
    "check": "npm run test:coverage && npm run check:package"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "c8": "12.0.0",
    "jest": "30.5.2",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
